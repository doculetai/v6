# OCR alternatives (v5 fallbacks; v6 uses ANTHROPIC_API_KEY)
# GOOGLE_VISION_API_KEY — Google Cloud Vision (v6 does not use)
# AWS Textract: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
# OpenAI Vision: OPENAI_API_KEY
# Tesseract: TESSERACT_WORKER_PATH
# Paddle OCR: PADDLE_OCR_ENABLED=true
# Google Document AI: GOOGLE_CLOUD_PROJECT_ID, DOCUMENT_AI_LOCATION, DOCUMENT_AI_PROCESSOR_ID
# ClamAV scan: CLAMAV_SCAN_SECRET
# Verification webhooks: VERIFICATION_BANKING_WEBHOOK_SECRET, VERIFICATION_DOCUMENTS_WEBHOOK_SECRET
